[sub_resource type="GDScript" id="GDScript_vacp5"]
script/source = "extends Node2D

var enemy_count := 0

signal add_died

func _on_enemy_died() -> void:
	enemy_count -= 1
	if enemy_count <= 0:
		add_died.emit()

func group_enable() -> void:
	for child in get_children():
		if child is Enemy:
			child.enable() 

func _ready() -> void:
	for node in get_children():
		if node is Enemy:
			enemy_count += 1
			node.died.connect(_on_enemy_died)
"

